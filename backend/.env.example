OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

MONGO_URI=mongodb://localhost:27017
MONGO_DB=book-recommender
MONGO_USERS_COLLECTION=users
MONGO_BOOKS_COLLECTION=books7k

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=books
QDRANT_VECTOR_SIZE=128

# simple: 128-d hash aligned with scripts/syncBooks.js; openai: use a Qdrant collection sized for that model (e.g. 1536)
EMBEDDING_BACKEND=simple

NODE_APP_URL=http://127.0.0.1:3000
INTERNAL_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Extra LLM pass to reorder Qdrant hits (latency + cost)
ENABLE_LLM_RERANK=false
