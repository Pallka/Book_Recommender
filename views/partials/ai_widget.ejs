          </svg>
        </button>
        <h5 class="ai-header-title" id="aiAgentModalLabel">AI-agent</h5>
        <button type="button" class="ai-icon-btn" id="aiAgentResetBtn" aria-label="Reset">

          <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
