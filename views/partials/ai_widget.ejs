          </svg>
        </button>
      </div>

      <div class="ai-body ai-scrollbar-hide" id="aiAgentScroll">
        <div style="display:flex; justify-content:center; padding: 8px 0 14px;">
          <img
            class="ai-agent-avatar"
            src="/sample_ai_agent/robot_svg.svg"
            alt="AI agent"
            style="width: 72px; height: auto; object-fit: contain;"
          />
        </div>
        <div class="ai-bubble-row assistant">
          <div class="ai-bubble assistant" id="aiAgentWelcomeText"></div>
        </div>
        <div id="aiAgentMessages" role="log" aria-live="polite"></div>
        <div id="aiAgentTyping" class="ai-typing-wrap" style="display:none;" aria-live="polite">
          <div class="ai-bubble-row assistant">
            <div class="ai-bubble assistant ai-typing-bubble">
              <span class="ai-typing-dots" aria-hidden="true">
                <span class="ai-dot"></span>
                <span class="ai-dot"></span>
                <span class="ai-dot"></span>
