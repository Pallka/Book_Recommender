<%# Loads /js/ai-agent.js %>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');
  .ai-agent-root, .ai-agent-root * { font-family: 'Manrope', sans-serif; }

  .ai-agent-fab {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 1055;
    width: 64px;
    height: 64px;
    border: 0;
    padding: 0;
    border-radius: 16px;
    background: transparent;
    box-shadow: 0 12px 28px rgba(0,0,0,.18);
    transition: transform .12s ease, filter .12s ease, box-shadow .12s ease;
  }
  .ai-agent-fab svg { width: 100%; height: 100%; display:block; }
  .ai-agent-fab:hover {
    filter: drop-shadow(0 10px 18px rgba(127, 85, 57, .35));
  }
  .ai-agent-fab:active {
    transform: translateY(1px) scale(0.98);
    filter: drop-shadow(0 8px 14px rgba(127, 85, 57, .28));
  }
  .ai-agent-fab:focus-visible {
    outline: 3px solid var(--c4, #DDB892);
    outline-offset: 3px;
  }


  #aiAgentModal .modal-dialog {
    position: fixed;
    right: 22px;
    bottom: 100px;
    margin: 0;
    max-width: none;
    width: 420px;
  }
  @media (max-width: 420px) {
    #aiAgentModal .modal-dialog { right: 10px; left: 10px; width: auto; }
  }
  #aiAgentModal .modal-content {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #212529;
    background: var(--c6, #EDE0D4);
  }
  #aiAgentModal .modal-backdrop { opacity: .25; }

  .ai-header {
    height: 44px;
    background: #FFFFFF;
    display:flex;
    align-items:center;
    justify-content: space-between;
    padding: 0 12px;
  }
  .ai-header-title {
    font-size: 14px;
    font-weight: 700;
    color: #212529;
    margin: 0;
  }
  .ai-icon-btn {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    display:flex;
    align-items:center;
    justify-content:center;
    padding: 0;
  }
  .ai-icon-btn svg { width: 18px; height: 18px; }
 
  .ai-icon-btn:focus,
  .ai-icon-btn:active,
  .ai-icon-btn:focus-visible,
  .ai-send:focus,
  .ai-send:active,
  .ai-send:focus-visible,
  .ai-copy:focus,
  .ai-copy:active,
  .ai-feedback:focus,
  .ai-feedback:active {
    outline: none !important;
    box-shadow: none !important;
  }
  .ai-icon-btn:hover,
  .ai-icon-btn:active,
  .ai-send:hover,
  .ai-send:active {
    background: transparent !important;
  }

  .ai-body {
    padding: 12px;
    height: 520px;
    overflow: auto;
    background: #F7F7F7;
  }
  .ai-scrollbar-hide::-webkit-scrollbar { width: 8px; }
  .ai-scrollbar-hide::-webkit-scrollbar-thumb { background: rgba(0,0,0,.12); border-radius: 999px; }

  .ai-bubble-row { display:flex; margin: 10px 0; align-items: flex-start; }
  .ai-bubble-row.user { justify-content: flex-end; }
  .ai-bubble-row.assistant { justify-content: flex-start; }

  /* Copy + feedback icons (vertical), right of assistant bubble */
  .ai-assistant-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
    align-self: center;
    flex-shrink: 0;
  }

  .ai-bubble {
    max-width: 85%;
    border-radius: 16px;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.35;
  }
  .ai-bubble.user { background: #212529; color: #fff; }
  .ai-bubble.assistant { background: #fff; color: #212529; border: 1px solid rgba(33,37,41,.12); }

  /* Assistant bubbles: .ai-md + innerHTML from ai-agent.js (escaped plain text + lists) */
  .ai-bubble.assistant.ai-md {
    font-size: 12px;
    line-height: 1.45;
  }
  .ai-bubble.assistant.ai-md p {
    margin: 0 0 0.55em;
  }
  .ai-bubble.assistant.ai-md p:last-child { margin-bottom: 0; }
  .ai-bubble.assistant.ai-md ul {
    margin: 0.35em 0 0.55em;
    padding-left: 1.2em;
    list-style-type: disc;
  }
  .ai-bubble.assistant.ai-md li {
    margin: 0.25em 0;
    padding-left: 0.15em;
  }
  .ai-bubble.assistant.ai-md li::marker { color: rgba(33,37,41,.45); }
  .ai-bubble.assistant.ai-md strong {
    font-weight: 700;
    color: #1a1d20;
  }
  .ai-bubble.assistant.ai-md em {
    font-style: italic;
    color: #3d4146;
  }

  .ai-copy {
    margin-left: 0;
    align-self: center;
    border: 0 !important;
    padding: 4px;
    border-radius: 6px;
    opacity: .55;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    appearance: none;
    color: #212529;
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
  }
  .ai-copy:hover {
    opacity: .95;
    background: rgba(33, 37, 41, 0.08) !important;
    background-color: rgba(33, 37, 41, 0.08) !important;
  }
  .ai-copy:focus-visible {
    outline: 2px solid rgba(33, 37, 41, 0.28) !important;
    outline-offset: 2px;
    background: rgba(33, 37, 41, 0.06) !important;
  }
  .ai-copy:active {
    background: rgba(33, 37, 41, 0.12) !important;
    opacity: 1;
  }
  .ai-copy svg { width: 14px; height: 14px; display: block; }

  .ai-feedback {
    border: 0 !important;
    padding: 4px;
    border-radius: 6px;
    opacity: .55;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    appearance: none;
    background: transparent !important;
    box-shadow: none !important;
    line-height: 0;
  }
  .ai-feedback:hover {
    opacity: .95;
    background: rgba(33, 37, 41, 0.08) !important;
  }
  .ai-feedback:focus-visible {
    outline: 2px solid rgba(33, 37, 41, 0.28) !important;
    outline-offset: 2px;
  }
  .ai-feedback:active {
    background: rgba(33, 37, 41, 0.12) !important;
    opacity: 1;
  }
  .ai-feedback img {
    width: 16px;
    height: 16px;
    display: block;
    pointer-events: none;
  }
  .ai-feedback.is-selected {
    opacity: 1;
  }
  .ai-feedback-like.is-selected img {
    filter: brightness(0) saturate(100%) invert(27%) sepia(85%) saturate(2000%) hue-rotate(325deg) brightness(0.95);
  }
  .ai-feedback-dislike.is-selected img {
    filter: brightness(0) saturate(100%) invert(42%) sepia(8%) saturate(800%) hue-rotate(180deg);
  }
  .ai-feedback:disabled {
    opacity: .35;
    cursor: default;
    pointer-events: none;
  }

  .ai-input-wrap {
    background: #fff;
    border-top: 1px solid rgba(33,37,41,.12);
    padding: 10px;
  }
  .ai-input-row {
    border: 1px solid rgba(33,37,41,.25);
    border-radius: 10px;
    padding: 6px 8px;
    display:flex;
    gap: 8px;
    align-items:center;
    background: #fff;
  }
  .ai-input {
    border: 0;
    outline: none;
    background: transparent;
    width: 100%;
    font-size: 12px;
  }
  .ai-send {
    border: 0;
    background: transparent;
    padding: 4px;
    opacity: .85;
  }
  .ai-send:disabled { opacity: .35; }
  .ai-send svg { width: 18px; height: 18px; }

  .ai-status {
    font-size: 11px;
    opacity: .7;
    margin-top: 6px;
    min-height: 14px;
  }

  /* Clickable book cards rendered under assistant messages (server-resolved books from /api/ai/chat). */
  .ai-book-cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 8px 0 4px;
  }
  .ai-book-card {
    display: flex;
    align-items: stretch;
    gap: 10px;
    padding: 8px;
    border-radius: 12px;
    background: #ECECEC;
    color: #212529;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background .15s ease, transform .12s ease, box-shadow .15s ease, border-color .15s ease;
    max-width: 92%;
  }
  .ai-book-card:hover,
  .ai-book-card:focus-visible {
    background: #E2E2E2;
    border-color: rgba(33,37,41,.18);
    box-shadow: 0 6px 14px rgba(0,0,0,.08);
    text-decoration: none;
    color: #212529;
    outline: none;
  }
  .ai-book-card:active {
    transform: translateY(1px);
  }
  .ai-book-card-thumb {
    flex: 0 0 56px;
    width: 56px;
    height: 78px;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ai-book-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ai-book-card-thumb img.ai-book-card-thumb-fallback {
    width: 28px;
    height: 28px;
    object-fit: contain;
    opacity: .55;
  }
  .ai-book-card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }
  .ai-book-card-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #212529;
    line-height: 1.25;
    margin: 0 0 2px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    word-break: break-word;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .ai-book-card-cta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    line-height: 1.3;
    color: rgba(33, 37, 41, .75);
  }
  .ai-book-card-cta-icon {
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    opacity: .8;
  }

  /* Loading state while /api/ai/chat is in flight (.ai-is-thinking on .ai-agent-root) */
  .ai-typing-bubble {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    padding: 10px 14px !important;
  }
  .ai-typing-dots {
    display: inline-flex;
    gap: 5px;
    align-items: center;
  }
  .ai-typing-dots .ai-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #212529;
    opacity: 0.4;
    animation: ai-dot-bounce 1.05s ease-in-out infinite;
  }
  .ai-typing-dots .ai-dot:nth-child(2) { animation-delay: 0.16s; }
  .ai-typing-dots .ai-dot:nth-child(3) { animation-delay: 0.32s; }
  @keyframes ai-dot-bounce {
    0%, 70%, 100% { transform: translateY(0); opacity: 0.35; }
    35% { transform: translateY(-6px); opacity: 1; }
  }
  .ai-typing-label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(33, 37, 41, 0.5);
    letter-spacing: 0.03em;
  }

  .ai-agent-root.ai-is-thinking .ai-header {
    background: linear-gradient(110deg, #fff 0%, #f5f0ea 45%, #fff 55%, #f5f0ea 100%);
    background-size: 220% 100%;
    animation: ai-header-shimmer 2s ease-in-out infinite;
  }
  @keyframes ai-header-shimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .ai-agent-root.ai-is-thinking .ai-agent-avatar {
    animation: ai-avatar-float 1.25s ease-in-out infinite;
  }
  @keyframes ai-avatar-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-5px) scale(1.02); }
  }

  .ai-agent-root.ai-is-thinking .ai-input-row {
    border-color: rgba(221, 184, 146, 0.65);
    animation: ai-input-glow 1.8s ease-in-out infinite;
  }
  @keyframes ai-input-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(221, 184, 146, 0); }
    50% { box-shadow: 0 0 0 3px rgba(221, 184, 146, 0.2); }
  }

  .ai-agent-root.ai-is-thinking .ai-send {
    opacity: 0.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-typing-dots .ai-dot,
    .ai-agent-root.ai-is-thinking .ai-header,
    .ai-agent-root.ai-is-thinking .ai-agent-avatar,
    .ai-agent-root.ai-is-thinking .ai-input-row {
      animation: none !important;
    }
    .ai-agent-root.ai-is-thinking .ai-header { background: #fff; }
    .ai-typing-dots .ai-dot { opacity: 0.55; }
  }
</style>

<button
  type="button"
  class="ai-agent-fab"
  aria-label="Open AI assistant"
  data-bs-toggle="modal"
  data-bs-target="#aiAgentModal"
>

  <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
