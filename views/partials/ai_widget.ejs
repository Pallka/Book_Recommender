  <div class="modal-dialog">
    <div class="modal-content ai-agent-root">
      <div class="ai-header">
        <button type="button" class="ai-icon-btn" data-bs-dismiss="modal" aria-label="Close">
          <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
