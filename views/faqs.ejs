<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAQs</title>
    <link rel="stylesheet" href="./css/styles.css">
    <link rel="icon" type="image/svg" href="images/book.svg">    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
      .accordion {
            --bs-accordion-bg: var(--c2);
            --bs-accordion-border-color: var(--c3);
            --bs-accordion-border-radius: 8px;
        }

        /* Accordion header button */
        .accordion-button {
            background-color: var(--c5);
            color: #000;
            font-weight: 600;
        }

        /* Active (opened) state */
        .accordion-button:not(.collapsed) {
            background-color: var(--c4);
            color: var(--c2);
            box-shadow: none;
        }

        /* Arrow icon color */
        .accordion-button::after {
            filter: brightness(0.4);
        }

        /* Accordion body */
        .accordion-body {
            background-color: #fff;
            color: #212529;
        }

        /* Item border */
        .accordion-item {
            border-color: var(--c5);
        }

        /* Remove blue hover, focus and active states */
        .accordion-button:hover,
        .accordion-button:focus,
        .accordion-button:active {
            background-color: var(--c5);
            color: inherit;
            box-shadow: none;
            outline: none;
        }

        /* Remove focus ring */
        .accordion-button:focus {
            box-shadow: none;
        }

        /* Optional: keep same color when opened */
        .accordion-button:not(.collapsed) {
            box-shadow: none;
        }

        /* FAQ page: space before footer, last accordion visible when open */
        .faqs-main {
            padding-bottom: 3rem;
            margin-bottom: 2rem;
        }
        .faqs-accordion-wrap {
            scroll-margin-bottom: 2rem;
        }
    </style>
</head>
<body>
