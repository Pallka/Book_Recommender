# Local Mongo (path segment = db name in URI)
MONGO_URI=mongodb://localhost:27017/book-recommender
# Compose sets mongodb://mongo:27017/book-recommender — override only if needed

SECRET_KEY=change-me-in-production

# Primary AI: FastAPI at AI_SERVICE_URL (see ai-service/, docker-compose)
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=dev-shared-secret-change-me

# Node-only LLM fallback if Python chat fails: auto = Groq → OpenAI → Ollama
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# For ai-service when calling Node ML: http://127.0.0.1:3000
# NODE_APP_URL=http://127.0.0.1:3000

# Optional overrides for Python service / compose (defaults usually enough)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
